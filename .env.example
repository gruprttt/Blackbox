# Copy to .env and fill in what you need. Everything here is optional.
# `python3 run.py` and `docker compose up` both read it.

# The address people open the site at (no trailing slash). Needed for reset emails and Google.
BLACKBOX_BASE_URL=http://localhost:8080

# 0 = only the first account can register (lock the server to yourself)
BLACKBOX_SIGNUP=1

# "Continue with Google" — create an OAuth client (type: Web application) at
# https://console.cloud.google.com/apis/credentials and add this Authorized redirect URI:
#   <BLACKBOX_BASE_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Password-reset emails (any SMTP provider: Gmail app password, SendGrid, Mailgun, SES, …)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# starttls (port 587), ssl (port 465) or none
SMTP_TLS=starttls
